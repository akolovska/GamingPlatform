@model IEnumerable<GamingPlatform.Domain.Models.Game>

@{
    ViewData["Title"] = "Store";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body { background:#1b1b1b; color:#eee; }
    .filter-bar { background:#111; padding:15px; border-radius:8px; }
    .game-card { background:#2a2a2a; border-radius:10px; overflow:hidden; transition:transform .2s; }
    .game-card:hover { transform: scale(1.03); }
    .game-card img { height:180px; object-fit:cover; width:100%; }
    .price { font-weight:bold; color:#66c0f4; }
</style>

<h2 class="mb-3">Store</h2>

<!-- FILTER BAR -->
<form method="get" class="filter-bar mb-4 d-flex gap-2">
    <select name="genre" class="form-select">
        <option value="">All Genres</option>
        <option value="Action">Action</option>
        <option value="RPG">RPG</option>
        <option value="Strategy">Strategy</option>
    </select>

    <select name="filter" class="form-select">
        <option value="">All Games</option>
        <option value="Free">Free to Play</option>
        <option value="Popular">Most Popular</option>
        <option value="Trending">Trending</option>
    </select>

    <button class="btn btn-primary">Apply</button>
</form>

<!-- GAMES GRID -->
<div class="row g-4">
    @foreach (var game in Model)
    {
        <div class="col-md-3">
            <div class="game-card">
                <img src="@game.CoverImageUrl" alt="@game.Title" />
                <div class="p-3">
                    <h5>@game.Title</h5>
                    <small>@game.Genre • @game.Platform</small>
                    <p class="mt-2 price">
                        @(game.Price == 0 ? "Free to Play" : $"${game.Price}")
                    </p>
                    <p class="mt-1 text-light small"><strong>System Requirements:</strong> @game.SystemRequirements</p>
                    <a asp-action="Details" asp-route-id="@game.Id" class="btn btn-sm btn-outline-light w-100">
                        View Game
                    </a>
                </div>
            </div>
        </div>
    }
</div>
