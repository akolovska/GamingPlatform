@using GamingPlatform.Web.Helpers
@using GamingPlatform.Domain.DTO
@using GamingPlatform.Domain.Identity
@model PagedResult<GameDto>

@{
    ViewData["Title"] = "Store";

    var query = ViewBag.Query as StoreQueryDto ?? new StoreQueryDto();
    var genres = ViewBag.Genres as List<GenreDto> ?? new();
    var trending = ViewBag.Trending as List<GameDto> ?? new();
    var recommendations = ViewBag.Recommendations as List<RecommendationDto> ?? new();
    var featured = trending.FirstOrDefault();

    // Every link keeps the other filters; only the given values change
    object Route(int? page = null, Guid? genreId = null, bool clearGenre = false) => new
    {
        q = query.Q,
        genreId = clearGenre ? null : genreId ?? query.GenreId,
        free = query.Free ? true : (bool?)null,
        onSale = query.OnSale ? true : (bool?)null,
        comingSoon = query.ComingSoon ? true : (bool?)null,
        sort = query.Sort == StoreSort.Name ? null : query.Sort.ToString(),
        page = page is > 1 ? page : null
    };
}

@if (featured != null)
{
    <section class="hero">
        @if (!string.IsNullOrEmpty(featured.CoverImageUrl))
        {
            <div class="hero-bg" style="background-image:url('@featured.CoverImageUrl')"></div>
        }
        <div class="hero-body">
            <span class="badge-pill mb-2">Featured &middot; trending this week</span>
            <h1 class="display-5">@featured.Title</h1>
            <p class="mb-3 col-lg-7 text-truncate" style="max-width:640px">@featured.Description</p>
            <div class="d-flex align-items-center gap-3">
                <a asp-action="Details" asp-route-id="@featured.Id" class="btn btn-primary">View game</a>
                <partial name="_Price" model="GameCardModel.From(featured)" />
            </div>
        </div>
    </section>
}

<div class="page-header">
    <h2>Store</h2>
    @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Dev))
    {
        <a asp-action="Create" class="btn btn-success">+ Add game</a>
    }
</div>

@foreach (var row in recommendations)
{
    <div class="section-title">Because you played <a asp-controller="Libraries" asp-action="Details" asp-route-id="@row.BasedOnId">&nbsp;@row.BasedOnTitle</a></div>
    <div class="scroller mb-2">
        @foreach (var game in row.Games)
        {
            <div><partial name="_GameCard" model="GameCardModel.From(game)" /></div>
        }
    </div>
}

@if (trending.Count > 1)
{
    <div class="section-title">Trending this week</div>
    <div class="scroller mb-2">
        @foreach (var game in trending)
        {
            <div><partial name="_GameCard" model="GameCardModel.From(game)" /></div>
        }
    </div>
}

<div class="section-title">@(query.IsFiltered ? "Search results" : "Browse all")</div>

@* A plain GET form: filters work without JavaScript; site.js submits it when a box or the sort changes *@
<form method="get" asp-action="Index" class="toolbar mb-3">
    <input type="hidden" name="genreId" value="@query.GenreId" />
    <input name="q" value="@query.Q" type="search" class="form-control form-control-sm" style="width:220px" placeholder="Search titles, genres, studios..." autocomplete="off" />
    <label class="chip mb-0 @(query.Free ? "active" : "")"><input type="checkbox" name="free" value="true" class="d-none" data-autosubmit checked="@query.Free" />Free to play</label>
    <label class="chip mb-0 @(query.OnSale ? "active" : "")"><input type="checkbox" name="onSale" value="true" class="d-none" data-autosubmit checked="@query.OnSale" />On sale</label>
    <label class="chip mb-0 @(query.ComingSoon ? "active" : "")"><input type="checkbox" name="comingSoon" value="true" class="d-none" data-autosubmit checked="@query.ComingSoon" />Coming soon</label>
    <select name="sort" class="form-select form-select-sm" style="width:auto" data-autosubmit aria-label="Sort by">
        <option value="Name" selected="@(query.Sort == StoreSort.Name)">Name (A-Z)</option>
        <option value="Popular" selected="@(query.Sort == StoreSort.Popular)">Most popular</option>
        <option value="TopRated" selected="@(query.Sort == StoreSort.TopRated)">Top rated</option>
        <option value="Newest" selected="@(query.Sort == StoreSort.Newest)">Newest first</option>
        <option value="PriceLow" selected="@(query.Sort == StoreSort.PriceLow)">Price: low to high</option>
        <option value="PriceHigh" selected="@(query.Sort == StoreSort.PriceHigh)">Price: high to low</option>
    </select>
    <button type="submit" class="btn btn-primary btn-sm">Search</button>
    <small class="text-muted ms-auto">@Model.TotalCount @(Model.TotalCount == 1 ? "game" : "games")</small>
</form>

<div class="d-flex flex-wrap gap-2 mb-4">
    <a asp-action="Index" asp-all-route-data="@ToStrings(Route(clearGenre: true))" class="chip @(query.GenreId == null ? "active" : "")">All genres</a>
    @foreach (var g in genres)
    {
        <a asp-action="Index" asp-all-route-data="@ToStrings(Route(genreId: g.Id))" class="chip @(g.Id == query.GenreId ? "active" : "")">@g.Name</a>
    }
</div>

@if (Model.Items.Any())
{
    <div class="row g-4">
        @foreach (var game in Model.Items)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <partial name="_GameCard" model="GameCardModel.From(game)" />
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="d-flex justify-content-center align-items-center gap-2 mt-4" aria-label="Pages">
            @if (Model.Page > 1)
            {
                <a asp-action="Index" asp-all-route-data="@ToStrings(Route(page: Model.Page - 1))" class="btn btn-outline-secondary btn-sm">&larr; Previous</a>
            }
            <span class="text-muted small">Page @Model.Page of @Model.TotalPages</span>
            @if (Model.Page < Model.TotalPages)
            {
                <a asp-action="Index" asp-all-route-data="@ToStrings(Route(page: Model.Page + 1))" class="btn btn-outline-secondary btn-sm">Next &rarr;</a>
            }
        </nav>
    }
}
else
{
    <div class="empty-state">
        <span class="icon">&#127918;</span>
        No games match your search.
        <div class="mt-3"><a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset filters</a></div>
    </div>
}

@functions {
    // asp-all-route-data wants a dictionary of strings; empty values are left out of the URL
    private static Dictionary<string, string> ToStrings(object values) =>
        values.GetType().GetProperties()
            .Select(p => (p.Name, Value: p.GetValue(values)?.ToString()))
            .Where(x => !string.IsNullOrEmpty(x.Value))
            .ToDictionary(x => x.Name, x => x.Value!);
}
