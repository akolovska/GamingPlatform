@model GamingPlatform.Domain.DTO.GameFormDto

@{
    ViewData["Title"] = "Add game";
    ViewData["Mode"] = "Create";
}

<div class="page-header">
    <h2>Add game</h2>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">&larr; Back to store</a>
</div>

<form asp-action="Create" method="post">
    <partial name="_GameForm" model="Model" view-data="ViewData" />
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
