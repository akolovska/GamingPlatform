@model GamingPlatform.Domain.DTO.GameDetailsDto
@using GamingPlatform.Web.Helpers

@{
    ViewData["Title"] = Model.Title;
    bool isLoggedIn = User.Identity?.IsAuthenticated == true;
    var loginUrl = Url.Page("/Account/Login", new { area = "Identity", returnUrl = Context.Request.Path });
    var card = GameCardModel.From(Model);
    string reviewSort = ViewBag.ReviewSort as string ?? "helpful";
    string buyLabel = Model.IsFree ? "Add to Library" : Model.IsComingSoon ? "Pre-order" : "Buy Now";
}

<nav aria-label="breadcrumb" class="mb-3 small">
    <a asp-action="Index">Store</a>
    @if (Model.Genres.Any())
    {
        <span class="text-muted"> / @string.Join(", ", Model.Genres)</span>
    }
    <span class="text-muted"> / @Model.Title</span>
</nav>

@if (Model.IsDelisted)
{
    <div class="alert alert-warning">This game is no longer available in the store.</div>
}

<div class="row g-4 detail-wrap">
    <!-- LEFT: cover + purchase -->
    <div class="col-lg-5">
        <div class="cover">
            @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
            {
                <img src="@Model.CoverImageUrl" class="detail-cover" alt="@Model.Title" />
            }
            else
            {
                <div class="cover-placeholder detail-cover" style="aspect-ratio:16/10">No cover image</div>
            }
        </div>

        <div class="buy-box mt-3 flex-column align-items-stretch gap-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2"><partial name="_Price" model="card" /></div>
                @if (Model.ReviewCount > 0)
                {
                    <div class="small text-end">
                        <span class="review-summary @card.ReviewTone">@Model.ReviewSummary</span>
                        <span class="text-muted">(@Model.PositivePercent% of @Model.ReviewCount)</span>
                    </div>
                }
            </div>

            @if (Model.IsOnSale && Model.DiscountEndsAt != null)
            {
                <div class="small text-muted">Sale ends @Model.DiscountEndsAt.Value.AddDays(-1).ToString("MMMM d").</div>
            }
            @if (Model.IsComingSoon)
            {
                <div class="small" style="color:var(--warning)">Coming @(Model.ReleaseDate?.ToString("MMMM d, yyyy")). Pre-order now and it's in your library on release day.</div>
            }

            <div class="d-flex flex-wrap gap-2">
                @if (!isLoggedIn)
                {
                    if (!Model.IsDelisted)
                    {
                        <a href="@loginUrl" class="btn btn-primary">Log in to buy</a>
                    }
                }
                else if (Model.InLibrary)
                {
                    <a asp-controller="Libraries" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">&#10003; In your library</a>
                }
                else if (!Model.IsDelisted)
                {
                    <form asp-controller="Orders" asp-action="BuyNow" method="post"
                          data-confirm="@(Model.IsFree ? $"Add {Model.Title} to your library?" : $"{buyLabel} {Model.Title} for ${Model.CurrentPrice:0.00}?")">
                        <input type="hidden" name="gameId" value="@Model.Id" />
                        <button type="submit" class="btn btn-primary">@buyLabel</button>
                    </form>

                    @if (!Model.IsFree)
                    {
                        @if (Model.InCart)
                        {
                            <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-secondary">&#128722; In cart</a>
                        }
                        else
                        {
                            <form asp-controller="Cart" asp-action="Add" method="post">
                                <input type="hidden" name="gameId" value="@Model.Id" />
                                <button type="submit" class="btn btn-outline-secondary">&#128722; Add to cart</button>
                            </form>
                        }
                    }

                    @if (Model.InWishlist)
                    {
                        <form asp-controller="Wishlists" asp-action="RemoveFromWishlist" method="post">
                            <input type="hidden" name="gameId" value="@Model.Id" />
                            <button type="submit" class="btn btn-outline-secondary">&#9829; Wishlisted</button>
                        </form>
                    }
                    else
                    {
                        <form asp-controller="Wishlists" asp-action="AddToWishlist" method="post">
                            <input type="hidden" name="gameId" value="@Model.Id" />
                            <button type="submit" class="btn btn-outline-secondary">&#9825; Wishlist</button>
                        </form>
                    }
                }

                @if (isLoggedIn && !Model.IsDelisted && Model.GiftableFriends.Any())
                {
                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#gift-box">&#127873; Gift</button>
                }
            </div>

            @if (isLoggedIn && !Model.IsDelisted && Model.GiftableFriends.Any())
            {
                <div class="collapse" id="gift-box">
                    <form asp-controller="Orders" asp-action="Gift" method="post" class="d-flex gap-2"
                          data-confirm="Send @Model.Title as a gift@(Model.IsFree ? "" : $" for ${Model.CurrentPrice:0.00}")?">
                        <input type="hidden" name="gameId" value="@Model.Id" />
                        <select name="friendId" class="form-select form-select-sm" required aria-label="Friend to gift to">
                            <option value="">Choose a friend...</option>
                            @foreach (var friend in Model.GiftableFriends)
                            {
                                <option value="@friend.Id">@friend.UserName</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-primary btn-sm text-nowrap">Send gift</button>
                    </form>
                    <div class="form-text">Only friends who don't own it yet are listed. They get it straight away.</div>
                </div>
            }
        </div>

        @if (Model.CanManage)
        {
            <div class="panel mt-3 d-flex gap-2 align-items-center">
                <span class="text-muted small me-auto">Manage this game</span>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">Edit</a>
                <form asp-action="SetListed" method="post"
                      data-confirm="@(Model.IsDelisted ? "Relist this game in the store?" : "Remove this game from the store? Owners keep it.")">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="listed" value="@(Model.IsDelisted ? "true" : "false")" />
                    <button type="submit" class="btn btn-outline-danger btn-sm">@(Model.IsDelisted ? "Relist" : "Delist")</button>
                </form>
            </div>
        }
    </div>

    <!-- RIGHT: info -->
    <div class="col-lg-7">
        <h1 class="fw-bold mb-2">@Model.Title</h1>
        <div class="d-flex flex-wrap gap-2 mb-3">
            @foreach (var g in Model.Genres)
            {
                <span class="badge-pill">@g</span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Platform))
            {
                <span class="badge-pill">@Model.Platform</span>
            }
            @if (Model.ReleaseDate != null)
            {
                <span class="badge-pill">@(Model.IsComingSoon ? "Coming" : "Released") @Model.ReleaseDate.Value.ToString("MMM d, yyyy")</span>
            }
        </div>

        @if (Model.TrailerEmbedUrl != null)
        {
            <iframe class="trailer mb-3" src="@Model.TrailerEmbedUrl" title="@Model.Title trailer" loading="lazy"
                    allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        }
        @if (Model.Screenshots.Any())
        {
            <div class="gallery mb-3">
                @foreach (var shot in Model.Screenshots)
                {
                    <a href="@shot" target="_blank" rel="noopener"><img src="@shot" alt="Screenshot of @Model.Title" loading="lazy" /></a>
                }
            </div>
        }

        <ul class="nav nav-pills nav-pills-dark mb-3" role="tablist">
            <li class="nav-item"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#tab-about" type="button">About</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-ach" type="button">Achievements <span class="badge-pill">@Model.Achievements.Count</span></button></li>
            <li class="nav-item"><button class="nav-link" id="reviews-tab" data-bs-toggle="pill" data-bs-target="#tab-rev" type="button">Reviews <span class="badge-pill">@Model.ReviewCount</span></button></li>
        </ul>

        <div class="tab-content">
            <div class="tab-pane fade show active" id="tab-about">
                <p style="white-space:pre-line">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description yet." : Model.Description)</p>

                <div class="row g-3 mt-1">
                    <div class="col-md-6">
                        <div class="panel h-100">
                            <h6 class="text-uppercase small text-muted">Developers</h6>
                            @if (Model.Developers.Any())
                            {
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var dev in Model.Developers)
                                    {
                                        <a asp-controller="Studios" asp-action="Details" asp-route-id="@dev.Id" class="badge-pill">@dev.Name</a>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">No developers listed.</span>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="panel h-100">
                            <h6 class="text-uppercase small text-muted">System requirements</h6>
                            @if (!string.IsNullOrEmpty(Model.SystemRequirements))
                            {
                                <div class="small" style="white-space:pre-line">@Model.SystemRequirements</div>
                            }
                            else
                            {
                                <span class="text-muted">Not specified.</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="tab-ach">
                @if (Model.Achievements.Any())
                {
                    foreach (var achievement in Model.Achievements)
                    {
                        <div class="achievement">
                            <div class="ico">&#127942;</div>
                            <div>
                                <div class="fw-semibold text-white">@achievement.Name</div>
                                @if (!string.IsNullOrEmpty(achievement.Description))
                                {
                                    <div class="small text-muted">@achievement.Description</div>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">No achievements available.</div>
                }
            </div>

            <div class="tab-pane fade" id="tab-rev">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                    <div>
                        <span class="review-summary @card.ReviewTone">@Model.ReviewSummary</span>
                        @if (Model.ReviewCount > 0)
                        {
                            <span class="text-muted small">&middot; @Model.PositivePercent% of @Model.ReviewCount reviews rate it 4 or 5 stars</span>
                        }
                    </div>
                    @if (Model.Reviews.Count > 1)
                    {
                        <div class="small">
                            <a asp-route-id="@Model.Id" asp-route-reviews="helpful" asp-fragment="tab-rev" class="@(reviewSort == "helpful" ? "fw-bold" : "")">Most helpful</a> &middot;
                            <a asp-route-id="@Model.Id" asp-route-reviews="newest" asp-fragment="tab-rev" class="@(reviewSort == "newest" ? "fw-bold" : "")">Newest</a>
                        </div>
                    }
                </div>

                @if (Model.CanReview)
                {
                    <button type="button" class="btn btn-outline-secondary btn-sm mb-3" data-bs-toggle="collapse" data-bs-target="#add-review">
                        Write a review
                    </button>

                    <div class="collapse mb-3" id="add-review">
                        <form asp-controller="Reviews" asp-action="Create" method="post" class="review">
                            <input type="hidden" name="gameId" value="@Model.Id" />
                            <div class="mb-2">
                                <label for="review-score" class="form-label">Score</label>
                                <select id="review-score" name="Score" class="form-select form-select-sm w-auto" required>
                                    @for (int i = 5; i >= 1; i--)
                                    {
                                        <option value="@i">@i ★</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-2">
                                <label for="review-comment" class="form-label">Comment</label>
                                <textarea id="review-comment" name="Comment" class="form-control" rows="3" maxlength="1000" required></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm">Post review</button>
                        </form>
                    </div>
                }
                else if (Model.InLibrary && Model.IsComingSoon)
                {
                    <p class="text-muted small">You can review this game once it's released.</p>
                }

                @if (Model.Reviews.Any())
                {
                    foreach (var review in Model.Reviews)
                    {
                        <div class="review" id="review-@review.Id">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex gap-2 align-items-center">
                                    <strong>@review.GamerName</strong>
                                    <span class="stars">@(new string('★', review.Score))<span class="off">@(new string('★', Math.Max(0, 5 - review.Score)))</span></span>
                                </div>
                                <div class="d-flex gap-2 align-items-center">
                                    <small class="text-muted">@review.DateRated?.ToString("MMM d, yyyy")</small>
                                    @* The server checks these again: only the author edits, the author or an admin deletes *@
                                    @if (review.IsMine)
                                    {
                                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                                data-bs-toggle="collapse" data-bs-target="#edit-review-@review.Id">Edit</button>
                                    }
                                    @if (review.CanDelete)
                                    {
                                        <form asp-controller="Reviews" asp-action="Delete" asp-route-id="@review.Id" method="post"
                                              data-confirm="Delete this review?">
                                            <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                        </form>
                                    }
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(review.Comment))
                            {
                                <div class="mt-1" style="white-space:pre-line">@review.Comment</div>
                            }

                            <div class="d-flex align-items-center gap-2 mt-2 small text-muted">
                                @if (review.CanVote)
                                {
                                    <span>Helpful?</span>
                                    @foreach (var (helpful, label, count) in new[] { (true, "👍", review.Upvotes), (false, "👎", review.Downvotes) })
                                    {
                                        <form asp-controller="Reviews" asp-action="Vote" asp-route-id="@review.Id" method="post">
                                            <input type="hidden" name="helpful" value="@(helpful ? "true" : "false")" />
                                            <input type="hidden" name="gameId" value="@Model.Id" />
                                            <input type="hidden" name="reviews" value="@reviewSort" />
                                            <button type="submit" class="vote-btn @(review.MyVote == helpful ? "active" : "")" data-no-loading
                                                    aria-label="@(helpful ? "Helpful" : "Not helpful")@(review.MyVote == helpful ? " (your vote, click to undo)" : "")">
                                                @label @count
                                            </button>
                                        </form>
                                    }
                                }
                                else if (review.Upvotes + review.Downvotes > 0)
                                {
                                    <span>&#128077; @review.Upvotes &middot; &#128078; @review.Downvotes</span>
                                }
                            </div>

                            @if (review.IsMine)
                            {
                                <div class="collapse mt-2" id="edit-review-@review.Id">
                                    <form asp-controller="Reviews" asp-action="Edit" asp-route-id="@review.Id" method="post">
                                        <input type="hidden" name="gameId" value="@Model.Id" />
                                        <div class="d-flex gap-2 mb-2">
                                            <select name="Score" class="form-select form-select-sm w-auto" required>
                                                @for (int i = 5; i >= 1; i--)
                                                {
                                                    <option value="@i" selected="@(i == review.Score)">@i ★</option>
                                                }
                                            </select>
                                            <button type="submit" class="btn btn-primary btn-sm">Save</button>
                                        </div>
                                        <textarea name="Comment" class="form-control form-control-sm" rows="2" maxlength="1000" required>@review.Comment</textarea>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">No reviews yet.</div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Links to #tab-rev or #review-... open the Reviews tab
        if (location.hash.startsWith('#review-') || location.hash === '#tab-rev') {
            bootstrap.Tab.getOrCreateInstance(document.getElementById('reviews-tab')).show();
            var target = document.querySelector(location.hash);
            if (target) setTimeout(function () { target.scrollIntoView({ block: 'center' }); }, 200);
        }
    </script>
}
