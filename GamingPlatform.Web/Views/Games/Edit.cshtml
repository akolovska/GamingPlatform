@model GamingPlatform.Domain.DTO.GameFormDto

@{
    ViewData["Title"] = "Edit game";
    ViewData["Mode"] = "Edit";
}

<div class="page-header">
    <h2>Edit &ldquo;@Model.Title&rdquo;</h2>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">&larr; Back to game</a>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
    <partial name="_GameForm" model="Model" view-data="ViewData" />
</form>

@* The achievement fields are shown inside the Achievements panel in _GameForm,
   but they submit with this form (a form can't be placed inside another form). *@
<form id="add-achievement-form" asp-action="Create" asp-controller="Achievements" method="post">
    <input type="hidden" name="gameId" value="@Model.Id" />
</form>

@* Empty form used by the Delete buttons in _GameForm (each button sets its own formaction). *@
<form id="delete-achievement-form" asp-controller="Achievements" asp-action="Delete" method="post"></form>

@* One form per achievement; the Name/Description inputs in _GameForm point at it with form="edit-achievement-{id}". *@
@foreach (var a in ViewBag.Achievements as List<GamingPlatform.Domain.Models.Achievement> ?? new())
{
    <form id="edit-achievement-@a.Id" asp-controller="Achievements" asp-action="Edit" asp-route-id="@a.Id" method="post">
        
    </form>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
