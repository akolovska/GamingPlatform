@model GamingPlatform.Domain.DTO.GameFormDto

@{
    ViewData["Title"] = "Edit game";
    ViewData["Mode"] = "Edit";
}

<div class="page-header">
    <h2>Edit &ldquo;@Model.Title&rdquo;</h2>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">&larr; Back to game</a>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
    <partial name="_GameForm" model="Model" view-data="ViewData" />
</form>

@{ var screenshots = ViewBag.Screenshots as List<string> ?? new(); }
<div class="panel mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">Screenshots <small class="text-muted fs-6">@screenshots.Count / 10</small></h5>
    </div>
    @if (screenshots.Any())
    {
        <div class="gallery mb-3">
            @foreach (var shot in screenshots)
            {
                <div class="shot">
                    <img src="@shot" alt="" loading="lazy" />
                    <form asp-action="DeleteScreenshot" asp-route-id="@Model.Id" method="post" data-confirm="Remove this screenshot?">
                        <input type="hidden" name="url" value="@shot" />
                        <button type="submit" class="btn btn-danger btn-sm" aria-label="Remove screenshot">&times;</button>
                    </form>
                </div>
            }
        </div>
    }
    @if (screenshots.Count < 10)
    {
        <form asp-action="AddScreenshots" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="d-flex gap-2">
            <input type="file" name="screenshots" accept=".jpg,.jpeg,.png,.webp" multiple required class="form-control" />
            <button type="submit" class="btn btn-outline-secondary text-nowrap">Upload</button>
        </form>
        <div class="form-text">JPG, PNG or WebP, up to 2 MB each. You can pick several at once.</div>
    }
</div>

@* The achievement fields are shown inside the Achievements panel in _GameForm,
   but they submit with these forms (a form can't be placed inside another form). *@
<form id="add-achievement-form" asp-action="Create" asp-controller="Achievements" method="post">
    <input type="hidden" name="gameId" value="@Model.Id" />
</form>

@* Empty form used by the Delete buttons in _GameForm (each button sets its own formaction). *@
<form id="delete-achievement-form" asp-controller="Achievements" asp-action="Delete" method="post"></form>

@* One form per achievement; the Name/Description inputs in _GameForm point at it with form="edit-achievement-{id}". *@
@foreach (var a in ViewBag.Achievements as List<GamingPlatform.Domain.DTO.AchievementDto> ?? new())
{
    <form id="edit-achievement-@a.Id" asp-controller="Achievements" asp-action="Edit" asp-route-id="@a.Id" method="post">
        <input type="hidden" name="gameId" value="@Model.Id" />
    </form>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
