@using GamingPlatform.Web.Helpers
@model IEnumerable<GamingPlatform.Domain.DTO.GameDto>

@{
    ViewData["Title"] = "Wishlist";
}

<div class="page-header">
    <h2>Wishlist <small class="text-muted fs-6">@Model.Count() @(Model.Count() == 1 ? "game" : "games")</small></h2>
    <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">&larr; Back</a>
</div>

@if (!Model.Any())
{
    <div class="empty-state"><span class="icon">&#9825;</span>This wishlist is empty.</div>
}
else
{
    <div class="row g-4">
        @foreach (var game in Model)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <partial name="_GameCard" model="GameCardModel.From(game)" />
            </div>
        }
    </div>
}
