@using GamingPlatform.Web.Helpers
@model IEnumerable<GamingPlatform.Domain.DTO.GameDto>

@{
    ViewData["Title"] = "My Wishlist";
}

<div class="page-header">
    <h2>My Wishlist <small class="text-muted fs-6">@Model.Count() @(Model.Count() == 1 ? "game" : "games")</small></h2>
    <a asp-controller="Account" asp-action="Edit" class="btn btn-outline-secondary btn-sm">Privacy settings</a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <span class="icon">&#9825;</span>
        Your wishlist is empty.
        <div class="mt-3"><a asp-controller="Games" asp-action="Index" class="btn btn-primary btn-sm">Browse the store</a></div>
    </div>
}
else
{
    <div class="row g-4" id="game-grid">
        @foreach (var game in Model)
        {
            <div class="col-6 col-md-4 col-lg-3"
                 data-title="@(game.Title?.ToLowerInvariant())"
                 data-meta="@(($"{string.Join(" ", game.GameGenres.Where(x => x.Genre != null).Select(x => x.Genre!.Name))} {game.Platform}").ToLowerInvariant())"
                 data-price="@((game.Price ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture))">
                <partial name="_GameCard" model="GameCardModel.From(game)" />
            </div>
        }
    </div>
    <div id="no-results" class="empty-state d-none">No games match your search.</div>
}
