@model GamingPlatform.Domain.DTO.StudioDashboardDto
@{
    ViewData["Title"] = $"{Model.StudioName} dashboard";
}

<div class="page-header">
    <h2>@Model.StudioName <small class="text-muted fs-6">dashboard</small></h2>
    <div class="d-flex gap-2 align-items-center">
        @if (Model.AllStudios.Count > 1)
        {
            @* Admins can look at any studio *@
            <form method="get" asp-action="Dashboard">
                <select name="id" class="form-select form-select-sm" data-autosubmit aria-label="Studio">
                    @foreach (var s in Model.AllStudios)
                    {
                        <option value="@s.Id" selected="@(s.Id == Model.StudioId)">@s.Name</option>
                    }
                </select>
            </form>
        }
        <a asp-action="Details" asp-route-id="@Model.StudioId" class="btn btn-outline-secondary btn-sm">Public page</a>
    </div>
</div>

<div class="row g-3 mb-4">
    @foreach (var (label, value) in new[]
    {
        ("Revenue", $"${Model.Revenue:0.00}"),
        ("Copies sold", Model.UnitsSold.ToString()),
        ("Owners", Model.Owners.ToString()),
        ("Average rating", Model.AverageRating is { } avg ? $"{avg:0.0} / 5" : "–")
    })
    {
        <div class="col-6 col-lg-3">
            <div class="panel h-100">
                <div class="text-muted small">@label</div>
                <div class="fs-3 fw-bold text-white">@value</div>
            </div>
        </div>
    }
</div>
<p class="text-muted small">Revenue and copies sold count paid orders (gifts included, refunds left out). Owners also counts free games and older purchases from before orders were recorded.</p>

<div class="panel mb-4">
    <h5 class="mb-3">Average rating, last 12 months</h5>
    @if (Model.ReviewCount == 0)
    {
        <p class="text-muted mb-0">No reviews yet.</p>
    }
    else
    {
        @* A bar per month: height = average rating out of 5; empty months have no bar *@
        <div class="d-flex align-items-end gap-2" style="height:160px" role="img" aria-label="Average rating per month">
            @foreach (var m in Model.RatingByMonth)
            {
                var height = m.AverageRating is { } r ? (int)Math.Round(r / 5 * 130) : 0;
                <div class="flex-fill d-flex flex-column align-items-center justify-content-end h-100"
                     title="@m.Month.ToString("MMMM yyyy"): @(m.AverageRating is { } a ? $"{a:0.0} from {m.ReviewCount} review(s)" : "no reviews")">
                    <span class="small text-white">@(m.AverageRating is { } v ? v.ToString("0.0") : "")</span>
                    <div style="width:100%;max-width:36px;height:@(height)px;background:var(--accent);border-radius:4px 4px 0 0"></div>
                    <span class="small text-muted mt-1">@m.Month.ToString("MMM")</span>
                </div>
            }
        </div>
    }
</div>

<div class="panel">
    <h5 class="mb-3">Games</h5>
    @if (!Model.Games.Any())
    {
        <p class="text-muted mb-0">No games yet. <a asp-controller="Games" asp-action="Create">Add one</a>.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead>
                    <tr><th>Game</th><th class="text-end">Owners</th><th class="text-end">Sold</th><th class="text-end">Revenue</th><th>Reviews</th></tr>
                </thead>
                <tbody>
                    @foreach (var g in Model.Games)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Games" asp-action="Details" asp-route-id="@g.GameId">@g.Title</a>
                                @if (g.IsDelisted) { <span class="badge-pill ms-1">delisted</span> }
                            </td>
                            <td class="text-end">@g.Owners</td>
                            <td class="text-end">@g.UnitsSold</td>
                            <td class="text-end">$@g.Revenue.ToString("0.00")</td>
                            <td class="small">
                                @if (g.ReviewCount > 0)
                                {
                                    <span class="review-summary @GamingPlatform.Service.ReviewSummary.Tone(g.ReviewSummary)">@g.ReviewSummary</span>
                                    <span class="text-muted">&middot; @g.AverageRating?.ToString("0.0") ★ (@g.ReviewCount)</span>
                                }
                                else
                                {
                                    <span class="text-muted">None yet</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
