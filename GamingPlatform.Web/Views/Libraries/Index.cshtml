@model IEnumerable<GamingPlatform.Domain.DTO.GameDto>

@{
    ViewData["Title"] = "My Library";
}

<h2 class="mb-4">My Library</h2>

@if (!Model.Any())
{
    <p>You haven’t purchased any games yet.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var game in Model)
        {
            <div class="col">
                <div class="card h-100">
                    <!-- Cover image -->
                    <img src="@game.CoverImageUrl" class="card-img-top" alt="@game.Title" style="height:200px; object-fit:cover;">

                    <div class="card-body">
                        <h5 class="card-title">@game.Title</h5>
                        <p class="card-text text-truncate">@game.Description</p>
                        <p class="card-text"><small class="text-muted">@game.Genre | @game.Platform</small></p>
                        <p class="card-text">
                            <strong>Price:</strong> @(game.Price == 0 ? "Free to Play" : $"${game.Price}")
                        </p>

                        <!-- Details button -->
                        <a asp-controller="Libraries"
                           asp-action="Details"
                           asp-route-id="@game.Id"
                           class="btn btn-primary">View Details</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
