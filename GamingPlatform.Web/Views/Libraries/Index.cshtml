@using GamingPlatform.Web.Helpers
@model IEnumerable<GamingPlatform.Domain.DTO.GameDto>

@{
    ViewData["Title"] = "My Library";
    const string controller = "Libraries";
}

<div class="page-header">
    <h2>My Library <small class="text-muted fs-6">@Model.Count() @(Model.Count() == 1 ? "game" : "games")</small></h2>
    <a asp-controller="Games" asp-action="Index" class="btn btn-outline-secondary btn-sm">Browse store</a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <span class="icon">&#127922;</span>
        You haven't added any games yet.
        <div class="mt-3"><a asp-controller="Games" asp-action="Index" class="btn btn-primary btn-sm">Find a game</a></div>
    </div>
}
else
{
    <div class="row g-4" id="game-grid">
        @foreach (var game in Model)
        {
            <div class="col-6 col-md-4 col-lg-3"
                 data-title="@(game.Title?.ToLowerInvariant())"
                 data-meta="@(($"{game.Genre} {game.Platform}").ToLowerInvariant())"
                 data-price="@((game.Price ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture))">
                <partial name="_GameCard" model="@GameCardModel.From(game, controller)" />
            </div>
        }
    </div>
    <div id="no-results" class="empty-state d-none">No games match your search.</div>
}
