@model GamingPlatform.Domain.DTO.GameDto

@{
    ViewData["Title"] = Model.Title;
}

<nav class="mb-3 small">
    <a asp-action="Index">Library</a> <span class="text-muted">/ @Model.Title</span>
</nav>

<div class="row g-4 detail-wrap">
    <div class="col-lg-5">
        <div class="cover">
            @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
            {
                <img src="@Model.CoverImageUrl" class="detail-cover" alt="@Model.Title" />
            }
            else
            {
                <div class="cover-placeholder detail-cover" style="aspect-ratio:16/10">No cover image</div>
            }
        </div>
        <div class="buy-box mt-3">
            <div>
                @if (Model.IsComingSoon)
                {
                    <span class="badge-pill" style="color:var(--warning)">Pre-ordered</span>
                    <div class="small text-muted mt-1">Available @Model.ReleaseDate?.ToString("MMMM d, yyyy").</div>
                }
                else
                {
                    <span class="badge-pill" style="color:#a4d007">&#10003; Owned</span>
                }
                @if (Model.IsDelisted)
                {
                    <div class="small text-muted mt-1">No longer sold in the store, but it stays in your library.</div>
                }
            </div>
            <a asp-controller="Games" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">Store page</a>
        </div>
    </div>

    <div class="col-lg-7">
        <h1 class="fw-bold mb-2">@Model.Title</h1>
        <div class="d-flex flex-wrap gap-2 mb-3">
            @foreach (var genre in Model.Genres) { <span class="badge-pill">@genre</span> }
            @if (!string.IsNullOrWhiteSpace(Model.Platform)) { <span class="badge-pill">@Model.Platform</span> }
            @if (Model.Rating != null) { <span class="badge-pill"><span class="stars">★</span> @Model.Rating.Value.ToString("0.0") / 5</span> }
        </div>

        <p style="white-space:pre-line">@Model.Description</p>

        <div class="row g-3">
            <div class="col-md-6">
                <div class="panel h-100">
                    <h6 class="text-uppercase small text-muted">Developers</h6>
                    @if (Model.Developers.Any())
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var dev in Model.Developers) { <a asp-controller="Studios" asp-action="Details" asp-route-id="@dev.Id" class="badge-pill">@dev.Name</a> }
                        </div>
                    }
                    else { <span class="text-muted">None listed.</span> }
                </div>
            </div>
            <div class="col-md-6">
                <div class="panel h-100">
                    <h6 class="text-uppercase small text-muted">System requirements</h6>
                    @if (!string.IsNullOrEmpty(Model.SystemRequirements))
                    {
                        <div class="small" style="white-space:pre-line">@Model.SystemRequirements</div>
                    }
                    else { <span class="text-muted">Not specified.</span> }
                </div>
            </div>
        </div>

        <div class="section-title">Achievements</div>
        @if (Model.Achievements.Any())
        {
            foreach (var a in Model.Achievements)
            {
                <div class="achievement">
                    <div class="ico">&#127942;</div>
                    <div>
                        <div class="fw-semibold text-white">@a.Name</div>
                        @if (!string.IsNullOrEmpty(a.Description)) { <div class="small text-muted">@a.Description</div> }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">No achievements available.</div>
        }
    </div>
</div>
