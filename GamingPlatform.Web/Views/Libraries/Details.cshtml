@model GamingPlatform.Domain.DTO.GameDto

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-4">
            <img src="@Model.CoverImageUrl" class="img-fluid rounded" alt="@Model.Title" />
        </div>

        <div class="col-md-8">
            <h2>@Model.Title</h2>
            <p class="text-muted">@Model.Genre | @Model.Platform</p>
            <p>@Model.Description</p>
            <h4 class="text-success">
                @(Model.Price == 0 ? "Free to Play" : $"${Model.Price}")
            </h4>

            <!-- System requirements -->
            @if (!string.IsNullOrEmpty(Model.SystemRequirements))
            {
                <h5>System Requirements</h5>
                <p>@Model.SystemRequirements</p>
            }

            <!-- Developers -->
            <h5>Developers</h5>
            @if (Model.Developers != null && Model.Developers.Any())
            {
                <ul>
                    @foreach (var dev in Model.Developers)
                    {
                        <li>@dev</li>
                    }
                </ul>
            }

            <!-- Achievements -->
            <h5>Available Achievements</h5>
            @if (Model.Achievements != null && Model.Achievements.Any())
            {
                <ul>
                    @foreach (var achievement in Model.Achievements)
                    {
                        <li>@achievement</li>
                    }
                </ul>
            }
            else
            {
                <p>No achievements available.</p>
            }

            <!-- Ratings -->
            <h5>Ratings</h5>
            @if (Model.Rating != null)
            {
                <p>@Model.Rating / 5 ⭐</p>
            }
            else
            {
                <p>No ratings yet.</p>
            }
        </div>
    </div>
</div>
