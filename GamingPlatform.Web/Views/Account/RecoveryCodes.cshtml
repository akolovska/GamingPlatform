@model string[]
@{
    ViewData["Title"] = "Recovery codes";
}

<div class="auth-wrap">
    <div class="auth-card">
        <h2 class="mb-2">Save your recovery codes</h2>
        <div class="alert alert-warning">
            <strong>This is the only time you'll see them.</strong> If you lose your phone, each code lets you log in once.
            Keep them somewhere safe, like a password manager.
        </div>
        <div class="recovery-codes panel mb-3">
            @foreach (var code in Model)
            {
                <span>@code</span>
            }
        </div>
        <a asp-action="Edit" class="btn btn-primary w-100">I've saved them</a>
    </div>
</div>
