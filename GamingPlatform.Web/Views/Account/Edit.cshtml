@model GamingPlatform.Domain.DTO.ProfileEditDto
@using GamingPlatform.Web.Helpers
@{
    ViewData["Title"] = "Account settings";
    var avatarUrl = ViewBag.ProfilePictureUrl as string;
    var security = ViewBag.Security as GamingPlatform.Domain.DTO.SecurityStatusDto ?? new();
    var providers = ViewBag.ExternalProviders as List<Microsoft.AspNetCore.Authentication.AuthenticationScheme> ?? new();
}

<div class="page-header">
    <h2>Account settings</h2>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">&larr; Back to profile</a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <form asp-action="Edit" method="post" class="panel">
            <h5 class="mb-3">Profile</h5>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <div class="form-text">If you change it, you'll need to confirm the new address.</div>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Bio" class="form-label"></label>
                <textarea asp-for="Bio" class="form-control" rows="4" maxlength="500"></textarea>
                <span asp-validation-for="Bio" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="WishlistVisibility" class="form-label"></label>
                <select asp-for="WishlistVisibility"
                        asp-items="Html.GetEnumSelectList<GamingPlatform.Domain.Enum.WishlistVisibility>()"
                        class="form-select"></select>
            </div>

            <div class="form-check mb-4">
                <input asp-for="WishlistSaleEmails" class="form-check-input" />
                <label asp-for="WishlistSaleEmails" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-success">Save changes</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
        </form>

        <div class="panel mt-4">
            <h5 class="mb-3">Security</h5>
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <div>
                    <div class="text-white">Password</div>
                    <div class="small text-muted">@(security.HasPassword ? "Used to log in with your username." : "You log in with Google. Set a password to also log in with your username.")</div>
                </div>
                <a asp-action="ChangePassword" class="btn btn-outline-secondary btn-sm">@(security.HasPassword ? "Change password" : "Set a password")</a>
            </div>

            <hr />
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <div>
                    <div class="text-white">Two-factor login @(security.TwoFactorEnabled ? "· On" : "· Off")</div>
                    <div class="small text-muted">
                        @if (security.TwoFactorEnabled)
                        {
                            @:After your password, you also enter a code from your authenticator app. @security.RecoveryCodesLeft recovery codes left.
                        }
                        else
                        {
                            @:Protect your account with a code from an authenticator app (Google Authenticator, Microsoft Authenticator, ...).
                        }
                    </div>
                </div>
                <div class="d-flex gap-2">
                    @if (security.TwoFactorEnabled)
                    {
                        <form asp-action="NewRecoveryCodes" method="post" data-confirm="Make new recovery codes? The old ones stop working.">
                            <button type="submit" class="btn btn-outline-secondary btn-sm">New recovery codes</button>
                        </form>
                        <form asp-action="DisableTwoFactor" method="post" data-confirm="Turn off two-factor login? Your account will only be protected by your password.">
                            <button type="submit" class="btn btn-outline-danger btn-sm">Turn off</button>
                        </form>
                    }
                    else
                    {
                        <a asp-action="EnableAuthenticator" class="btn btn-primary btn-sm">Turn on</a>
                    }
                </div>
            </div>

            @if (providers.Any() || security.LinkedProviders.Any())
            {
                <hr />
                <div class="text-white mb-2">Connected accounts</div>
                @foreach (var provider in providers)
                {
                    bool linked = security.LinkedProviders.Contains(provider.DisplayName ?? provider.Name);
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span>@provider.DisplayName <span class="small text-muted">@(linked ? "· connected" : "")</span></span>
                        @if (linked)
                        {
                            <form asp-action="RemoveLogin" method="post" data-confirm="Disconnect @provider.DisplayName?">
                                <input type="hidden" name="provider" value="@provider.Name" />
                                <button type="submit" class="btn btn-outline-secondary btn-sm">Disconnect</button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="LinkLogin" method="post">
                                <input type="hidden" name="provider" value="@provider.Name" />
                                <button type="submit" class="btn btn-outline-secondary btn-sm" data-no-loading>Connect</button>
                            </form>
                        }
                    </div>
                }
            }
        </div>

        <div class="panel mt-4 border-danger">
            <h5 class="mb-2 text-danger">Delete account</h5>
            <p class="text-muted mb-3">
                Permanently deletes your account, library, wishlist and friends list. Your reviews stay, shown as written by "Deleted user". This can't be undone.
            </p>
            <a asp-action="Delete" class="btn btn-outline-danger">Delete my account</a>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="panel text-center">
            <h5 class="mb-3 text-start">Profile picture</h5>
            <img id="avatarPreview" src="@AvatarHelper.Resolve(avatarUrl)" alt="" class="avatar-lg mb-3" style="width:128px;height:128px;border-radius:50%;object-fit:cover;border:3px solid var(--accent)" />

            <form asp-action="UploadAvatar" method="post" enctype="multipart/form-data" class="mb-2">
                <input type="file" id="avatarFile" name="avatarFile" accept=".jpg,.jpeg,.png,.webp" class="form-control mb-2" />
                <button type="submit" class="btn btn-primary btn-sm w-100">Upload</button>
            </form>

            @if (!string.IsNullOrEmpty(avatarUrl))
            {
                <form asp-action="RemoveAvatar" method="post" data-confirm="Remove your profile picture?">
                    <button type="submit" class="btn btn-outline-secondary btn-sm w-100">Remove picture</button>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
