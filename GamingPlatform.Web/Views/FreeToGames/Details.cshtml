@model GamingPlatform.Domain.API.FreeToGameGame
@{
    ViewData["Title"] = Model.Title;
}

<nav class="mb-3 small">
    <a asp-action="Index">Free games</a> <span class="text-muted">/ @Model.Title</span>
</nav>

<div class="row g-4 detail-wrap">
    <div class="col-lg-5">
        <div class="cover">
            <img src="@Model.Thumbnail" class="detail-cover" alt="@Model.Title" />
        </div>
    </div>
    <div class="col-lg-7">
        <h1 class="fw-bold mb-2">@Model.Title</h1>
        <div class="d-flex flex-wrap gap-2 mb-3">
            @if (!string.IsNullOrWhiteSpace(Model.Genre)) { <span class="badge-pill">@Model.Genre</span> }
            @if (!string.IsNullOrWhiteSpace(Model.Platform)) { <span class="badge-pill">@Model.Platform</span> }
            @if (!string.IsNullOrWhiteSpace(Model.ReleaseDate)) { <span class="badge-pill">Released @Model.ReleaseDate</span> }
        </div>
        <p>@Model.ShortDescription</p>
        <p class="small text-muted">
            Developer: @Model.Developer<br />
            Publisher: @Model.Publisher
        </p>
        <div class="d-flex gap-2">
            @* rel="noopener" stops the external site from controlling this tab *@
            <a href="@Model.GameUrl" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Play game</a>
            <a href="@Model.FreeToGameProfileUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary">FreeToGame page</a>
        </div>
    </div>
</div>
