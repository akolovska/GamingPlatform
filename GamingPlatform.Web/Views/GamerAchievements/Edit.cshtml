@model GamingPlatform.Domain.Models.GamerAchievement

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Edit</h1>

<h4>GamerAchievement</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="GamerId" class="control-label"></label>
                <select asp-for="GamerId" class="form-control" asp-items="ViewBag.GamerId"></select>
                <span asp-validation-for="GamerId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AchievementId" class="control-label"></label>
                <select asp-for="AchievementId" class="form-control" asp-items="ViewBag.AchievementId"></select>
                <span asp-validation-for="AchievementId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DateUnlocked" class="control-label"></label>
                <input asp-for="DateUnlocked" class="form-control" />
                <span asp-validation-for="DateUnlocked" class="text-danger"></span>
            </div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
