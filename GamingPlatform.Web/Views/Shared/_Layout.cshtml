@using Microsoft.AspNetCore.Identity
@using GamingPlatform.Domain.Identity
@using GamingPlatform.Web.Helpers
@inject SignInManager<GamingPlatformUser> SignInManager
@inject UserManager<GamingPlatformUser> UserManager
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    bool signedIn = SignInManager.IsSignedIn(User);
    string avatar = AvatarHelper.Default;
    if (signedIn)
    {
        var me = await UserManager.GetUserAsync(User);
        avatar = AvatarHelper.Resolve(me?.ProfilePictureUrl);
    }
    string NavActive(string c) => string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <title>@ViewData["Title"] - GamingPlatform</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GamingPlatform.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg site-nav">
            <div class="container">
                <a class="navbar-brand" asp-controller="Games" asp-action="Index">Gaming<span>Platform</span></a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon" style="filter:invert(1)"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-3 mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link @NavActive("Games")" asp-controller="Games" asp-action="Index">Store</a></li>
                        @if (signedIn)
                        {
                            <li class="nav-item"><a class="nav-link @NavActive("Libraries")" asp-controller="Libraries" asp-action="Index">Library</a></li>
                            <li class="nav-item"><a class="nav-link @NavActive("Wishlists")" asp-controller="Wishlists" asp-action="Index">Wishlist</a></li>
                            <li class="nav-item"><a class="nav-link @NavActive("Account")" asp-controller="Account" asp-action="Index">Community</a></li>
                            <li class="nav-item"><a class="nav-link @NavActive("Admin")" asp-controller="Admin" asp-action="FreeToGame">FreeToGame</a></li>
                        }
                    </ul>

                    <form id="nav-search-form" class="nav-search me-auto mb-2 mb-lg-0" role="search"
                          data-store-url="@Url.Action("Index", "Games")">
                        <i aria-hidden="true">&#128269;</i>
                        <input id="nav-search" class="form-control form-control-sm" type="search" placeholder="Search the store..." autocomplete="off" />
                    </form>

                    <ul class="navbar-nav ms-lg-3 align-items-lg-center">
                        @if (signedIn)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <img src="@avatar" class="avatar-sm" alt="" />
                                    <span>@User.Identity?.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Index">My profile</a></li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Edit">Edit profile</a></li>
                                    <li><a class="dropdown-item" asp-controller="Libraries" asp-action="Index">My library</a></li>
                                    <li><a class="dropdown-item" asp-controller="Wishlists" asp-action="Index">My wishlist</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                                            <button type="submit" class="dropdown-item" data-no-loading>Log out</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Log in</a></li>
                            <li class="nav-item ms-lg-2"><a class="btn btn-primary btn-sm" asp-area="Identity" asp-page="/Account/Register">Sign up</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted">
        <div class="container d-flex justify-content-between">
            <span>&copy; @DateTime.Now.Year GamingPlatform</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <!-- Toast stack: flash messages become toasts -->
    <div id="toast-stack" class="toast-stack" aria-live="polite">
        @foreach (var key in new[] { "Verified", "Blocked", "FriendMessage", "GameMessage", "Success", "AvatarError", "Error" })
        {
            if (TempData[key] is string msg && !string.IsNullOrWhiteSpace(msg))
            {
                <span hidden data-toast="@msg" data-kind="@(key is "AvatarError" or "Error" ? "warning" : "success")"></span>
            }
        }
    </div>

    <!-- Shared confirm dialog (used by <form data-confirm="...">) -->
    <div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Please confirm</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body confirm-text"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="confirmYes">Confirm</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
