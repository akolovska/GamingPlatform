@model GamingPlatform.Domain.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="empty-state mx-auto mt-4" style="max-width:520px">
    <span class="icon">&#9888;</span>
    <h4 class="text-white">Something went wrong</h4>
    <p>An error occurred while processing your request. Please try again in a moment.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small">Reference: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Games" asp-action="Index" class="btn btn-primary btn-sm">Back to the store</a>
</div>
