@model GamingPlatform.Web.Helpers.GameCardModel
@{
    var meta = string.Join(" • ", new[] { string.Join(", ", Model.Genres), Model.Platform }.Where(s => !string.IsNullOrWhiteSpace(s)));
}
<div class="game-card">
    @if (Model.Owned)
    {
        <span class="owned-ribbon">In library</span>
    }
    @if (Model.IsComingSoon)
    {
        <span class="soon-ribbon">Coming soon</span>
    }
    <div class="cover">
        @if (!string.IsNullOrEmpty(Model.Cover))
        {
            <img src="@Model.Cover" alt="@Model.Title" loading="lazy" />
        }
        else
        {
            <div class="cover-placeholder">No cover</div>
        }
    </div>
    <div class="body">
        <h3 class="title">
            <a class="stretched-link-card text-reset" asp-controller="@Model.Controller" asp-action="Details" asp-route-id="@Model.Id">@Model.Title</a>
        </h3>
        @if (meta.Length > 0)
        {
            <div class="meta text-truncate" title="@meta">@meta</div>
        }
        @if (Model.ReviewCount > 0)
        {
            <div class="small review-summary @Model.ReviewTone">@Model.ReviewSummary</div>
        }
        <div class="mt-auto pt-2 d-flex align-items-center gap-2">
            <partial name="_Price" model="Model" />
        </div>
    </div>
</div>
