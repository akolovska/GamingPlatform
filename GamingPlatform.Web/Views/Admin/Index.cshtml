@using GamingPlatform.Domain.DTO
@{
    ViewData["Title"] = "Admin";
    var genres = ViewBag.Genres as List<GenreDto> ?? new();
    var studios = ViewBag.Studios as List<StudioDto> ?? new();
}

<div class="page-header">
    <h2>Admin</h2>
</div>

<div class="row g-4">
    <!-- Studios -->
    <div class="col-lg-7">
        <div class="panel">
            <h5 class="mb-1">Studios</h5>
            <p class="text-muted small mb-3">Linking a user to a studio makes them a Dev, so they can publish and manage that studio's games. Each user manages at most one studio.</p>

            <form asp-action="CreateStudio" method="post" class="row g-2 mb-4">
                <div class="col-sm-5"><input name="name" class="form-control" placeholder="Studio name" maxlength="100" required /></div>
                <div class="col-sm-4"><input name="ownerUserName" class="form-control" placeholder="Manager's username (optional)" /></div>
                <div class="col-sm-3"><button type="submit" class="btn btn-success w-100">Add studio</button></div>
            </form>

            @if (studios.Any())
            {
                <div class="list-group">
                    @foreach (var s in studios)
                    {
                        <div class="list-group-item">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div>
                                    <a asp-controller="Studios" asp-action="Details" asp-route-id="@s.Id" class="fw-semibold">@s.Name</a>
                                    <span class="text-muted small ms-2">@s.GameCount @(s.GameCount == 1 ? "game" : "games")</span>
                                    <a asp-controller="Studios" asp-action="Dashboard" asp-route-id="@s.Id" class="small ms-2">dashboard</a>
                                </div>
                                @if (s.GameCount == 0)
                                {
                                    <form asp-action="DeleteStudio" method="post" data-confirm="Delete the studio @s.Name?">
                                        <input type="hidden" name="id" value="@s.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                    </form>
                                }
                            </div>
                            <form asp-action="SetStudioOwner" method="post" class="d-flex gap-2">
                                <input type="hidden" name="id" value="@s.Id" />
                                <input name="ownerUserName" value="@s.OwnerUserName" class="form-control form-control-sm" placeholder="No manager" />
                                <button type="submit" class="btn btn-outline-secondary btn-sm text-nowrap">Set manager</button>
                            </form>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted mb-0">No studios yet.</p>
            }
        </div>
    </div>

    <!-- Genres -->
    <div class="col-lg-5">
        <div class="panel">
            <h5 class="mb-3">Genres</h5>

            <form asp-action="AddGenre" method="post" class="d-flex gap-2 mb-4">
                <input name="name" class="form-control" placeholder="New genre" maxlength="50" required />
                <button type="submit" class="btn btn-success text-nowrap">Add genre</button>
            </form>

            @if (genres.Any())
            {
                <div class="list-group">
                    @foreach (var g in genres)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <span>
                                <span class="text-white">@g.Name</span>
                                <span class="text-muted small ms-2">@g.GameCount @(g.GameCount == 1 ? "game" : "games")</span>
                            </span>
                            @if (g.GameCount == 0)
                            {
                                <form asp-action="DeleteGenre" method="post" data-confirm="Delete the genre @g.Name?">
                                    <input type="hidden" name="id" value="@g.Id" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                </form>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted mb-0">No genres yet.</p>
            }
        </div>
    </div>
</div>
