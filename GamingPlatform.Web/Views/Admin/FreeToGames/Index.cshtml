@model List<GamingPlatform.API.Models.FreeToGameGame>

@{
    ViewData["Title"] = "FreeToGame Games";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    @foreach (var game in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <img src="@game.Thumbnail" class="card-img-top" alt="@game.Title" />
                <div class="card-body">
                    <h5 class="card-title">@game.Title</h5>
                    <p class="card-text">@game.ShortDescription</p>
                    <p><strong>Genre:</strong> @game.Genre</p>
                    <p><strong>Platform:</strong> @game.Platform</p>
                    <p><strong>Developer:</strong> @game.Developer</p>
                    <p><strong>Publisher:</strong> @game.Publisher</p>
                    <p><strong>Release Date:</strong> @game.ReleaseDate</p>
                    <a asp-controller="Admin"
                       asp-action="FreeToGameDetails"
                       asp-route-id="@game.Id"
                       class="btn btn-sm btn-primary">
                        Details
                    </a>
                    <a href="@game.GameUrl" target="_blank" class="btn btn-success">Play Game</a>
                </div>
            </div>
        </div>
    }
</div>
